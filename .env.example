# ---------------------------------------------------------------------------
# GeM Bid Compliance Verification Platform — environment template
# Copy to `.env` and adjust. ALL values below are safe demo defaults.
# ---------------------------------------------------------------------------

# --- Database ---
# Docker compose overrides this with PostgreSQL. Local default: SQLite (zero-config).
# DATABASE_URL=sqlite:///./storage/app.db
# DATABASE_URL=postgresql://gem:gem@db:5432/gem

# --- Auth ---
# REQUIRED in production: 32+ random bytes
JWT_SECRET=change-me-in-production-32bytes+
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Field-level encryption (Fernet key) ---
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a dev key is derived from JWT_SECRET (NOT for production).
ENCRYPTION_KEY=

# --- Integration layer (mock | apisetu | gsp | digilocker) ---
PORTAL_ADAPTER=mock

# --- AI / LLM (offline default: deterministic engine, no API key needed) ---
LLM_PROVIDER=offline        # offline | openai | ollama | auto
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- PKI trust (demo CA is generated automatically) ---
# Production: point at the real DigiLocker/GSTN/MCA signing CAs and set the
# expected issuer CN of the issuing authority.
EXPECTED_ISSUER_CN=Demo DigiLocker Issuing CA

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Auth rate limiting ---
AUTH_RATE_LIMIT_PER_MINUTE=20